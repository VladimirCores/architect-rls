{
  "name": "rls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "backend:dev": "bun run --cwd backend dev",
    "backend:start": "bun run --cwd backend start",
    "backend:build": "bun run --cwd backend build",
    "backend:test": "bun run --cwd backend test",
    "backend:typecheck": "bun run --cwd backend typecheck",
    "lint": "biome check backend/src",
    "lint:fix": "biome check --write backend/src",
    "format": "biome format --write backend/src",
    "e2e": "bash tests/e2e/run.sh",
    "e2e:install": "bash tests/e2e/run.sh --setup",
    "generate": "bun run --cwd backend generate",
    "generate:api": "bun run swagger:bundle && bun run --cwd backend generate",
    "swagger:ui": "podman compose -f docker-compose.yml up",
    "swagger:lint": "bunx redocly lint swagger/openapi.yaml",
    "swagger:bundle": "bunx redocly bundle swagger/openapi.yaml -o swagger/dist/openapi.json",
    "swagger:split": "bunx redocly split swagger/openapi.yaml --outDir swagger"
  },
  "packageManager": "bun@1.3.8",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@redocly/cli": "^2.53.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.1",
    "js-yaml": "^5.4.2"
  }
}
