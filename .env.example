# ─────────────────────────────────────────────────────────────
# RLS Simulator — Environment
# Копируется в .env через prepare-скрипт (ADR-0002).
# .env НЕ коммитится; .env.example — да.
# ─────────────────────────────────────────────────────────────

# Режим развёртывания (ADR-0008): local | web
DEPLOYMENT_TYPE=local

# Источник карт (ADR-0011/ADR-0022): region | manual
MAP_TILES=region

# HTTP
PORT=3000
# Bind-адрес (ADR-0008): localhost для desktop, 0.0.0.0 за reverse proxy
BIND_ADDRESS=127.0.0.1

# Базы данных (ADR-0011)
# Desktop — пути к SQLite-файлам; server — DATABASE_URL (Postgres)
DB_PATH=./data/app.db
ANALYTICS_DB_PATH=./data/analytics.db
# DATABASE_URL=postgres://user:pass@localhost:5432/rls

# Карты
MAPS_DIR=./assets/maps

# Записи экзаменов (.rlsrec)
RECORDINGS_DIR=./data/recordings

# Аналитика (ADR-0011): retention для событий на сервере
EVENTS_RETENTION_DAYS=365

# Реальная симуляция (ADR-0009)
INTERACTIVE_UPDATE_MS=16